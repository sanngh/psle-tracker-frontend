{
  "expo": {
    "name": "PSLE Tracker",
    "slug": "psle-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.psletracker.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1abc9c"
      }
    },
    "ios": {
      "bundleIdentifier": "com.psletracker.app",
      "supportsTablet": false,
      "buildNumber": "1"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow PSLE Tracker to use the camera to capture evidence photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1abc9c"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e2888cc2-3ed0-4c23-b587-9fe2b811635e"
      }
    },
    "owner": "sanngh"
  }
}
